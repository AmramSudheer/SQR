! Comment or uncomment the line below to toggle debug mode

 
Begin-Heading 5
   Print 'Training Listing Report' (1,1)
   Print 'Training ID'             (3,1)
   Print 'Training Name'           (3,20)
End-Heading
 
Begin-Program
   Do Main
End-Program
 
Begin-Procedure Main
 
 
   Begin-Select
TRAINING_ID &TRAINING_ID
TRAINING_NAME &TRAINING_NAME

 
      Print &TRAINING_ID   (+1,1)
      Print &TRAINING_NAME (,20)
	
 
   From PS_TRAINING_RECORD
   End-Select

 
End-Procedure
